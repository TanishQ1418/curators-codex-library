rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Collection Group Queries
    match /{path=**}/profile/{document} {
      allow read: if isAuthenticated();
    }

    // Users Collection
    match /users/{userId} {
      match /library/{itemId} {
        allow read: if isAuthenticated(); // Friends/others can view library if public
        allow write: if isOwner(userId);
      }
      
      match /profile/{document=**} {
        allow read: if isAuthenticated(); // Profile is visible to other users
        allow write: if isOwner(userId);
      }
      
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated(); // Anyone can send a notification
        allow update, delete: if isOwner(userId);
      }
      
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId); // Users manage their own friend statuses
      }
    }
    
    // Usernames mapping Collection (used for social search)
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only allow creation if the username is unique and maps to the authenticated user's UID
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // No updates or deletes for usernames mapping to prevent squatting for now
      allow update, delete: if false; 
    }
  }
}
